---
layout: layouts/base.njk
title: "Page not found | Assetas"
permalink: /404.html
sitemap: false
---
{#- GitHub Pages serves this for any URL that doesn't exist, at that URL. The script below runs before
    the page draws: it forwards near misses (wrong case, a trailing slash, dashes or underscores in the
    slug) to the real page, since Pages URLs are case-sensitive, then fills in the requested path and
    up to three closest pages. Without it, the page still works: the ticket reads "This address" and
    the directory is there. The hero trace plays once in CSS ("404 page" in main.css). -#}
<script>
(() => {
  const prefix = "{{ '/' | url }}";                         // "/Website/" on the preview, "/" live
  const pages = {{ collections.all | pageIndex(nav) | safe }};
  const redirects = {{ redirects | dump | safe }};

  const here = location.pathname;
  let asked = here.toLowerCase().startsWith(prefix.toLowerCase()) ? here.slice(prefix.length) : here.replace(/^\/+/, "");
  try { asked = decodeURIComponent(asked); } catch {}
  asked = "/" + asked;

  // "/Oil-and-Gas/" -> "oil-and-gas"; squash() also drops anything that isn't a letter, digit or slash.
  const key = (s) => s.toLowerCase().replace(/(\/index)?(\.html?)?\/*$/, "").replace(/^\/+/, "");
  const squash = (s) => key(s).replace(/[^a-z0-9/]/g, "");
  const want = key(asked);
  const targets = pages.map((p) => ({ from: p.url, to: p.url })).concat(redirects);
  const hit = want && (targets.find((t) => key(t.from) === want) || targets.find((t) => squash(t.from) === squash(want)));
  const dest = hit && prefix + hit.to.replace(/^\//, "");
  if (dest && dest !== here) {
    location.replace(dest + location.search + location.hash);
    return;
  }

  // Closest pages: edit distance on the slug, a bonus when one slug contains the other or the address
  // spells out an acronym slug ("leak-detection-and-repair" -> ldar), and a bonus for each word of the
  // address found in the page's name or title, and a smaller one for its description.
  const distance = (a, b) => {
    const row = Array.from({ length: b.length + 1 }, (_, j) => j);
    for (let i = 1; i <= a.length; i++) {
      let diag = row[0];
      row[0] = i;
      for (let j = 1; j <= b.length; j++) {
        const up = row[j];
        row[j] = Math.min(up + 1, row[j - 1] + 1, diag + (a[i - 1] === b[j - 1] ? 0 : 1));
        diag = up;
      }
    }
    return row[b.length];
  };
  const like = (a, b) => 1 - distance(a, b) / Math.max(a.length, b.length, 1);
  const tail = (s) => s.split("/").pop();
  const w = squash(want);
  const parts = want.split(/[^a-z0-9]+/).filter(Boolean);
  const minor = ["and", "the", "for", "of", "www", "html", "page", "assetas"];
  const words = parts.filter((x) => x.length > 2 && !minor.includes(x));
  const initials = [parts, parts.filter((x) => !minor.includes(x))].map((list) => list.map((x) => x[0]).join(""));
  const matches = pages
    .filter((p) => p.url !== "/")
    .map((p) => {
      const k = squash(p.url);
      let score = Math.max(like(w, k), like(tail(w), tail(k)));
      if (tail(w).length > 2 && tail(k).length > 2 && (k.includes(tail(w)) || tail(w).includes(tail(k)))) score = Math.max(score, 0.75);
      if (parts.length > 2 && initials.includes(tail(k))) score = Math.max(score, 0.9);
      const name = (p.label + " " + p.title).toLowerCase();
      const text = p.text.toLowerCase();
      words.forEach((x) => { score += name.includes(x) ? 0.2 : text.includes(x) ? 0.1 : 0; });
      return { ...p, score };
    })
    .filter((p) => p.score >= 0.5)
    .sort((a, b) => b.score - a.score)
    .slice(0, 3);

  const fill = () => {
    document.querySelectorAll("[data-asked]").forEach((el) => { el.textContent = asked; });
    const now = new Date();
    const two = (n) => String(n).padStart(2, "0");
    const time = document.querySelector("[data-reported]");
    if (time) {
      time.dateTime = now.toISOString();
      time.textContent = `${now.getFullYear()}-${two(now.getMonth() + 1)}-${two(now.getDate())} ${two(now.getHours())}:${two(now.getMinutes())}`;
    }
    const list = document.querySelector("[data-matches]");
    if (!list || !matches.length) return;
    list.replaceChildren(...matches.map((p) => {
      const item = document.createElement("li");
      const link = document.createElement("a");
      const label = document.createElement("span");
      const path = document.createElement("span");
      link.className = "match";
      link.href = prefix + p.url.replace(/^\//, "");
      label.className = "match-label";
      label.textContent = p.label;
      path.className = "match-path";
      path.textContent = p.url;
      link.append(label, path);
      item.append(link);
      return item;
    }));
    list.hidden = false;
    document.querySelector("[data-matches-none]").hidden = true;
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", fill);
  else fill();
})();
</script>

<section class="hero hero--signal">
  <div class="container">
    <p class="eyebrow">Error 404</p>
    <h1 class="measure">Where this link meets a dead end.</h1>
    <p class="lead">There's no page at this address. It may have moved, or the link has a typo. The closest matches are below.</p>
    <div class="button-row">
      <a class="button" href="/">Go to the home page</a>
      <a class="button button--outline" href="/platform">See the platform</a>
    </div>
  </div>
  {#- Decorative: a sensor feed that spikes and drops out, then a dashed line where readings should be. -#}
  <div class="signal" aria-hidden="true">
    <div class="container signal-labels">
      <span class="signal-tag">PT-404 · page feed</span>
      <span class="signal-readout">No signal</span>
    </div>
    <div class="signal-plot">
      <svg class="signal-trace" viewBox="0 0 1200 100" preserveAspectRatio="none" focusable="false">
        <defs>
          <linearGradient id="signal-fade" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-opacity="0.15"/>
            <stop offset="0.5" stop-opacity="0.6"/>
            <stop offset="0.66" stop-opacity="1"/>
          </linearGradient>
        </defs>
        <path class="signal-live" stroke="url(#signal-fade)" d="M0 55 L70 55 L78 50 L86 58 L94 55 L180 55 L188 48 L196 60 L204 55 L320 55 L328 51 L336 57 L344 55 L470 55 L478 46 L486 62 L494 55 L600 55 L608 50 L616 58 L624 55 L700 55 L708 40 L716 66 L724 12 L732 92 L740 30 L748 76 L756 46 L764 62 L772 58 L780 80 L790 80"/>
        <path class="signal-lost" d="M790 80 H1200"/>
      </svg>
      <span class="signal-dot"></span>
    </div>
  </div>
</section>

<section class="section">
  <div class="container not-found">
    <article class="ticket" aria-labelledby="ticket-title">
      <div class="ticket-head">
        <p class="ticket-id">WO-404</p>
        <p class="ticket-status">Open</p>
      </div>
      <div class="ticket-body">
        <h2 class="h4" id="ticket-title">Page not found</h2>
        <dl class="ticket-fields">
          <div><dt>Asset</dt><dd><span class="ticket-path" data-asked>This address</span></dd></div>
          <div><dt>Source</dt><dd>PT-404 — no signal</dd></div>
          <div><dt>Reported</dt><dd><time data-reported>Just now</time></dd></div>
          <div><dt>Finding</dt><dd>No page at this address. It moved, or the link has a typo.</dd></div>
          <div><dt>Corrective action</dt><dd>Pick a close match, or start from the directory.</dd></div>
        </dl>
      </div>
    </article>
    <div class="matches">
      <p class="eyebrow">Closest matches</p>
      <h2 class="h3-size">Pages near this address.</h2>
      <ul class="matches-list" data-matches hidden></ul>
      <p data-matches-none>Nothing close enough to suggest. Start from the directory below, or go to the <a class="text-link" href="/">home page</a>.</p>
    </div>
  </div>
</section>

<section class="section section--surface">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Directory</p>
      <h2>Start from a page that exists.</h2>
    </div>
    <div class="directory">
      {%- for group in nav.header %}{% if group.children %}
      <div class="directory-group{% if group.children.length > 6 %} directory-group--wide{% endif %}">
        <h3 class="directory-heading"><a href="{{ group.url }}">{{ group.label }}</a></h3>
        <ul>
          {%- for child in group.children %}
          <li><a href="{{ child.url }}">{{ child.label }}</a><p>{{ child.blurb }}</p></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endif %}{% endfor %}
    </div>
  </div>
</section>
