<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.name }}</title>
  {%- if description %}
  <meta name="description" content="{{ description }}">
  {%- endif %}
  {%- if site.noindex %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  {%- set canonical = (canonicalPath or (page.url | cleanUrl)) | absoluteUrl %}
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  {%- if description %}
  <meta property="og:description" content="{{ description }}">
  {%- endif %}
  <meta property="og:url" content="{{ canonical }}">
  {%- set ogImage = (ogImage or "/static/img/brand/og-default.png") | absoluteUrl %}
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Assetas">
  <meta name="twitter:card" content="summary_large_image">
  {%- if page.url == "/" %}
  {#- Organization details for search engines (home page only). -#}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Assetas Inc.",
    "url": "{{ '/' | absoluteUrl }}",
    "logo": "{{ '/static/img/brand/assetas-logo.png' | absoluteUrl }}",
    "email": "info@assetas.com",
    "sameAs": [{% for item in nav.social %}"{{ item.url }}"{% if not loop.last %}, {% endif %}{% endfor %}],
    "telephone": "+1-303-731-8629",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1001 Bannock Street, Ste 414",
      "addressLocality": "Denver",
      "addressRegion": "CO",
      "postalCode": "80204",
      "addressCountry": "US"
    }
  }
  </script>
  {%- endif %}

  <link rel="icon" href="/static/img/brand/favicon.ico" sizes="48x48 32x32">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&display=swap">
  <link rel="stylesheet" href="/static/css/tokens.css">
  <link rel="stylesheet" href="/static/css/main.css">
  {%- if site.gaId %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag("js", new Date());
    gtag("config", "{{ site.gaId }}");
  </script>
  {%- endif %}
  <script src="/static/js/menu.js" defer></script>
  {%- if rail %}
  <script src="/static/js/rail.js" defer></script>
  {%- endif %}
  {%- if survey %}
  <script src="/static/js/survey.js" defer></script>
  {%- endif %}
  {%- if stepper %}
  <script src="/static/js/stepper.js" defer></script>
  {%- endif %}
  {%- if tour %}
  <script src="/static/js/tour.js" defer></script>
  {%- endif %}
  {%- if compare %}
  <script src="/static/js/compare.js" defer></script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main"{% if pageClass %} class="{{ pageClass }}"{% endif %}>
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
