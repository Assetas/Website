{#- Theme preview, part 2 (preview builds only): a floating switcher. Styled with fixed values so
    no theme can restyle it. -#}
<div class="tp" role="region" aria-label="Theme preview">
  <span class="tp-label">Theme</span>
  <button type="button" data-theme-id="original">Original</button>
  {%- for t in site.themes %}
  <button type="button" data-theme-id="{{ t.id }}">{{ t.label }}</button>
  {%- endfor %}
</div>
<style>
  .tp { position: fixed; z-index: 1000; left: 50%; bottom: 14px; transform: translateX(-50%); display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 4px; max-width: calc(100vw - 24px); padding: 5px; border-radius: 14px; background: rgb(17 19 26 / 0.92); box-shadow: 0 10px 30px rgb(0 0 0 / 0.35), 0 0 0 1px rgb(255 255 255 / 0.08); font: 500 13px/1 system-ui, sans-serif; letter-spacing: 0; text-transform: none; backdrop-filter: blur(8px); }
  .tp-label { padding: 0 8px 0 6px; color: #8b93a7; }
  .tp button { all: unset; box-sizing: border-box; padding: 8px 11px; border-radius: 9px; color: #e8ebf2; cursor: pointer; font: inherit; }
  .tp button:hover { background: rgb(255 255 255 / 0.1); }
  .tp button:focus-visible { outline: 2px solid #4d9dff; outline-offset: 1px; }
  .tp button[aria-pressed="true"] { background: #006dff; color: #fff; }
  @media (max-width: 40rem) { .tp-label { display: none; } .tp button { padding: 7px 8px; font-size: 12px; } }
  @media print { .tp { display: none; } }
</style>
<script>
  (function () {
    var current = document.documentElement.getAttribute("data-theme") || "original";
    document.querySelectorAll(".tp button").forEach(function (b) {
      b.setAttribute("aria-pressed", String(b.dataset.themeId === current));
      b.addEventListener("click", function () {
        var url = new URL(location.href);
        url.searchParams.set("theme", b.dataset.themeId);
        location.href = url.href;
      });
    });
  })();
</script>
