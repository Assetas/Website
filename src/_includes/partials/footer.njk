<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="logo" href="/"><img src="/static/img/assetas-logo.png" alt="Assetas" width="160" height="39"></a>
      <p>{{ nav.footerTagline }}</p>
    </div>
    <nav class="footer-columns" aria-label="Footer">
      {%- for group in nav.footer %}
      <div>
        <h2 class="footer-heading">{{ group.heading }}</h2>
        <ul>
          {%- for item in group.links %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </nav>
  </div>
  <div class="container footer-legal">
    <p>&copy; {{ site.year }} Assetas Inc. All rights reserved.</p>
    <ul>
      {%- for item in nav.legal %}
      <li><a href="{{ item.url }}">{{ item.label }}</a></li>
      {%- endfor %}
      <li><a href="{{ site.statusUrl }}">System Status</a></li>
    </ul>
  </div>
</footer>
