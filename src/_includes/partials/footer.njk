<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="logo" href="/"><img src="/static/img/brand/assetas-logo-white.png" alt="Assetas" width="160" height="39"></a>
      <p>{{ nav.footerTagline }}</p>
      <ul class="footer-social">
        {%- for item in nav.social %}
        <li><a href="{{ item.url }}" target="_blank" rel="noopener" aria-label="Assetas on {{ item.label }}">
          {%- if item.icon == "linkedin" %}<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
          {%- elif item.icon == "youtube" %}<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.81 3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.81ZM9.6 15.57V8.43L15.82 12 9.6 15.57Z"/></svg>
          {%- endif %}</a></li>
        {%- endfor %}
      </ul>
    </div>
    <nav class="footer-columns" aria-label="Footer">
      {%- for group in nav.footer %}
      <div>
        <h2 class="footer-heading">{{ group.heading }}</h2>
        <ul>
          {%- for item in group.links %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </nav>
  </div>
  <div class="container footer-legal">
    <p>&copy; {{ site.year }} Assetas Inc. All rights reserved.</p>
    <ul>
      {%- for item in nav.legal %}
      <li><a href="{{ item.url }}">{{ item.label }}</a></li>
      {%- endfor %}
      <li><a href="{{ site.statusUrl }}">System Status</a></li>
    </ul>
  </div>
</footer>
