{
  "name": "assetas-website",
  "version": "0.1.0",
  "private": true,
  "description": "www.assetas.com, built with Eleventy for GitHub Pages",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
